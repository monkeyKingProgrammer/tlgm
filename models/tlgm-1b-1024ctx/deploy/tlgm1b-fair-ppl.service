[Unit]
Description=TLGM 1B fair WikiText perplexity comparison
After=network-online.target tlgm1b-reasoning.service
Wants=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/minimind/tlgm_1b_1024ctx
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DOWNLOAD_TIMEOUT=120
Environment=HF_HUB_ETAG_TIMEOUT=30
ExecStartPre=/home/user/venvs/tlgm/bin/python scripts/require_completed_reasoning_training.py
ExecStart=/home/user/venvs/tlgm/bin/python scripts/evaluate_fair_perplexity.py
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=300
RestartPreventExitStatus=3
